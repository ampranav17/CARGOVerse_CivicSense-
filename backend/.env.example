# ── ContainerVerse Real API Keys ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys

# Claude claude-sonnet-4-6 (Anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Mapbox GL JS — https://account.mapbox.com/
MAPBOX_TOKEN=pk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiJ...YOUR_TOKEN

# AIS Stream (real vessel positions) — https://aisstream.io/
AISSTREAM_API_KEY=YOUR_AISSTREAM_KEY

# GDELT (public, no key needed for v2 REST — leave blank)
GDELT_API_KEY=

# GDACS (public RSS — no key needed — leave blank)
GDACS_API_KEY=

# Deutsche Bahn Open Data (DB Cargo) — https://developer.deutschebahn.com/
DB_API_KEY=YOUR_DB_CLIENT_ID
DB_API_SECRET=YOUR_DB_CLIENT_SECRET

# JR Freight (Japan) — Simulated (no public API)
JR_FREIGHT_ENABLED=true

# Server
PORT=8000
